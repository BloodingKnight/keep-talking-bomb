{
  "name": "keep-talking-bomb",
  "version": "1.1.8",
  "private": true,
  "description": "本地多人合作拆弹游戏：一人看炸弹、其他人查手册，面向同一局域网/同一台电脑的多人分屏信息合作",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js 3210",
    "test": "node tests/selftest.mjs 40",
    "test:e2e": "node tests/run-e2e.mjs",
    "test:qr": "node tests/qr.mjs",
    "manual:text": "node tools/extract-pdf.mjs",
    "build:portable": "node tools/build-portable.mjs",
    "build:single": "node tools/build-single.mjs",
    "tauri:assets": "node tools/prepare-tauri-assets.mjs",
    "tauri:icon": "node tools/make-icon.mjs",
    "tauri:dev": "npm run tauri:assets && cd src-tauri && cargo tauri dev",
    "tauri:build": "npm run tauri:assets && npm run tauri:icon && cd src-tauri && cargo tauri icon logo.png && cargo tauri build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "coop",
    "bomb",
    "party-game",
    "local-multiplayer",
    "sse"
  ],
  "license": "MIT"
}
