{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BombGame",
  "version": "1.1.8",
  "identifier": "com.bloodingknight.bombgame",
  "build": {
    "frontendDist": "dist-ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "bundle-assets/**/*"
    ],
    "shortDescription": "本地多人合作拆弹",
    "longDescription": "一个人看炸弹、其他人查手册，全程靠你们自己沟通的本地合作拆弹游戏。"
  }
}
