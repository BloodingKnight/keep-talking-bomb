# 依赖（本项目零依赖，一般不会出现）
node_modules/
package-lock.json

# 打包产物（绿色版里有 90MB 的 node.exe，绝对不要进仓库）
dist/

# 打包用的临时目录（postject / npm 缓存）
.build/
.npmcache/

# Tauri 桌面版
src-tauri/target/
src-tauri/gen/
# 由 tools/prepare-tauri-assets.mjs 生成（含 90MB 的 node.exe）
src-tauri/bundle-assets/
# 由 cargo tauri icon logo.png 生成
src-tauri/icons/
# 试跑 npm create tauri-app 留下的模板目录，与集成版无关
keep-talking-bomb/

# 运行期日志
*.log
server.log
server.err.log

# 从附件 PDF 抽取出来的手册文本：只用于开发时核对玩法结构，
# 里面是第三方版权内容，不要发布到公开仓库。
tools/manual-text.txt
tools/manual-text.clean.txt
tools/manual-text*.*

# 附件/截图等本地文件
*.pdf
*.zip

# 系统文件
.DS_Store
Thumbs.db
desktop.ini
